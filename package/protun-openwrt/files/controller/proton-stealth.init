#!/bin/sh /etc/rc.common
USE_PROCD=1
START=90
STOP=10
# Only the transaction controller may request a tunnel; Direct boot stays Direct.
boot() { return 0; }
start_service() {
 [ -f /tmp/proton-runtime/stealth-wanted ] || return 0
 [ -s /tmp/proton-runtime/stealth.json ] || return 1
 /usr/sbin/protun-openwrt --check-config /tmp/proton-runtime/stealth.json >/dev/null || return 1
 procd_open_instance main
 procd_set_param command /usr/sbin/protun-openwrt --config /tmp/proton-runtime/stealth.json
 procd_set_param respawn 3600 30 0
 procd_set_param term_timeout 5
 procd_set_param stderr 1
 procd_set_param limits core="0"
 procd_close_instance
}
