#!/bin/sh
# The transaction controller installs dual-family guards before prepare.
set -e
umask 077
. /usr/lib/exit-node-common
state=/root/proton-private
dev=pt-proton
VPN_BACKEND=protun
VPN_DEV="$dev"
stop_tunnel() {
 rm -f "$PROTON_RUNTIME/client-wanted"
 /etc/init.d/proton-client stop 9>&- >/dev/null 2>&1 || true
 ubus call network.interface.proton_client remove >/dev/null 2>&1 || true
 for family in 4 6; do
  ip -"$family" rule del pref 10900 oif "$dev" lookup 620 2>/dev/null || true
  ip -"$family" rule del pref 10600 fwmark 0x620 lookup 620 2>/dev/null || true
  ip -"$family" route flush table 620 2>/dev/null || true
 done
 rm -f "$PROTON_RUNTIME/client-state.json" "$PROTON_RUNTIME/client-health.json" "$PROTON_RUNTIME/client.json" "$PROTON_RUNTIME/client.key"
}
add_tun_interface() {
 . /usr/share/libubox/jshn.sh
  json_init; json_add_string name proton_client; json_add_string proto static; json_add_string device "$dev"
  json_add_boolean defaultroute 0; json_add_boolean peerdns 0; json_add_boolean delegate 0
  json_add_array ipaddr; json_add_string '' '10.2.0.2/32'; json_close_array
  json_add_array ip6addr; json_add_string '' '2a07:b944::2:2/128'; json_close_array
  ubus call network add_dynamic "$(json_dump)" >/dev/null
}
restore_tun_interface() {
 local iface attempt
 vpn_context || return 1
 [ "$VPN_BACKEND" = protun ] || return 1
 [ -f "$PROTON_RUNTIME/client-wanted" ] || return 1
 # netifd removes dynamic logical interfaces when their TUN device disappears.
 # A supervised client can reconnect before host addressing has been restored.
 if iface="$(ubus call network.interface.proton_client status 2>/dev/null)"; then
  [ "$(jsonfilter -s "$iface" -e '@.up')" = true ] || ubus call network.interface.proton_client up >/dev/null || return 1
 else
  add_tun_interface || return 1
 fi
 for attempt in 1 2 3; do
  if ip -o address show dev "$dev" 2>/dev/null | grep -q '10.2.0.2/32' && ip -6 -o address show dev "$dev" 2>/dev/null | grep -q '2a07:b944::2:2/128'; then
   vpn_reconcile true
   return
  fi
  sleep 1
 done
 return 1
}
case "${1:-}" in
 prepare)
  file="${2:-$state/active.conf}"
  case "$file" in "$state/active.conf"|"$state/pending.conf") ;; *) exit 2;; esac
  stop_tunnel
  /usr/libexec/proton-transport-metadata >/dev/null 2>&1 || true
  [ -s "$state/transport-ports.json" ] || { echo 'Verified transport metadata is unavailable' >&2; exit 1; }
  uplink="$(uplink_device)" || exit 1
  endpoint="$(sed -n 's/^Endpoint[[:space:]]*=[[:space:]]*//p' "$file")"
  server_ip="${endpoint%:*}"
  case "$server_ip" in ''|*[!0-9.]*) echo 'Validated IPv4 server endpoint required' >&2; exit 1;; esac
  key="$(sed -n 's/^PrivateKey[[:space:]]*=[[:space:]]*//p' "$file")"
  public="$(sed -n 's/^PublicKey[[:space:]]*=[[:space:]]*//p' "$file")"
  [ -n "$key" ] && [ -n "$public" ] || exit 1
  printf '%s\n' "$key" > "$PROTON_RUNTIME/client.key"
  . /usr/share/libubox/jshn.sh
  json_init; json_add_string tun_name "$dev"; json_add_int tun_mtu 1280; json_add_string uplink_device "$uplink"
  json_add_string protocol "$VPN_PROTOCOL"; json_add_int socket_mark 1569; json_add_string server_ip "$server_ip"
  json_add_string server_public_key "$public"; json_add_string private_key_file "$PROTON_RUNTIME/client.key"
  json_add_int connect_timeout_seconds 60
  case "$VPN_PROTOCOL" in
   stealth) port_field=tls_ports;;
   wireguard-udp) port_field=udp_ports;;
   wireguard-tcp) port_field=tcp_ports;;
   *) exit 2;;
  esac
  json_add_array "$port_field"
  count=0
  for port in $(jsonfilter -i "$state/transport-ports.json" -e "@.$port_field[*]"); do
   case "$port" in ''|*[!0-9]*) exit 1;; esac
   [ "${#port}" -le 5 ] && [ "$port" -gt 0 ] && [ "$port" -le 65535 ] || exit 1
   count=$((count+1)); [ "$count" -le 16 ] || exit 1; json_add_int '' "$port"
  done
  [ "$count" -gt 0 ] || { echo 'No verified ports for selected protocol' >&2; exit 1; }
  json_close_array
  json_add_string status_file "$PROTON_RUNTIME/client-state.json"
  json_add_string status_instance "$(cat /proc/sys/kernel/random/uuid)"
  json_dump > "$PROTON_RUNTIME/client.json.new"; mv "$PROTON_RUNTIME/client.json.new" "$PROTON_RUNTIME/client.json"
  /usr/sbin/protun-openwrt --check-config "$PROTON_RUNTIME/client.json" >/dev/null
  addresses="$(sed -n 's/^Address[[:space:]]*=[[:space:]]*//p' "$file" | tr ',' ' ')"
  # These are the reviewed Protun core defaults. Reject a changed contract.
  [ "$(printf '%s\n' "$addresses" | tr -s ' ' | sed 's/^ //;s/ $//')" = '10.2.0.2/32 2a07:b944::2:2/128' ] || { echo 'Unexpected tunnel address contract' >&2; exit 1; }
  for family in 4 6; do
   ip -"$family" route replace unreachable default table 620 metric 32000
   ip -"$family" rule show | grep -q '^9000:.*fwmark 0x621.*lookup main' || ip -"$family" rule add pref 9000 fwmark 0x621 lookup main
   ip -"$family" rule show | grep -q '^10600:.*fwmark 0x620.*lookup 620' || ip -"$family" rule add pref 10600 fwmark 0x620 lookup 620
  done
  : > "$PROTON_RUNTIME/client-wanted"
  /etc/init.d/proton-client start 9>&- >/dev/null
  up=false
  for attempt in $(seq 1 40); do
   if vpn_engine_live && restore_tun_interface; then up=true; break; fi
   sleep 1
  done
  [ "$up" = true ] || exit 1
  for family in 4 6; do
   while ip -"$family" rule show | grep -q '^10900:'; do ip -"$family" rule del pref 10900; done
   ip -"$family" route replace default dev "$dev" table 620 metric 10
   ip -"$family" rule add pref 10900 oif "$dev" lookup 620
  done
  ;;
 test|health)
  exec 7>"$PROTON_RUNTIME/client-health.guard"
  if [ "$1" = health ]; then try_lock 7 || exit 0; else wait_lock 7 60 || exit 1; fi
  ready=false
  limit=40; [ "$1" != health ] || limit=1
  for attempt in $(seq 1 "$limit"); do if vpn_engine_live; then ready=true; break; fi; sleep 1; done
  [ "$ready" = true ] || exit 1
  restore_tun_interface || exit 1
  vpn_engine_ready || exit 1
  probe_pid="$(jsonfilter -i "$PROTON_RUNTIME/client-state.json" -e '@.pid')"
  probe_instance="$(jsonfilter -i "$PROTON_RUNTIME/client-state.json" -e '@.instance')"
  invalidate_health() {
   [ "$(jsonfilter -i "$PROTON_RUNTIME/client-health.json" -e '@.pid' 2>/dev/null || true)" != "$probe_pid" ] || rm -f "$PROTON_RUNTIME/client-health.json"
  }
  for family in 4 6; do
   if [ "$family" = 4 ]; then target='one.one.one.one:443:1.1.1.1'; else target='one.one.one.one:443:[2606:4700:4700::1111]'; fi
   curl -"$family" --interface "$dev" --retry 2 --retry-delay 2 --retry-all-errors --retry-max-time 20 --connect-timeout 5 --max-time 8 -fsS --resolve "$target" https://one.one.one.one/cdn-cgi/trace > "$state/health$family.trace" 7>&- || { invalidate_health; exit 1; }
   grep -q '^ip=' "$state/health$family.trace" || { invalidate_health; exit 1; }
  done
  vpn_engine_ready || exit 1
  [ "$probe_pid" = "$(jsonfilter -i "$PROTON_RUNTIME/client-state.json" -e '@.pid')" ] || exit 1
  [ "$probe_instance" = "$(jsonfilter -i "$PROTON_RUNTIME/client-state.json" -e '@.instance')" ] || exit 1
  . /usr/share/libubox/jshn.sh
  json_init; json_add_int monotonic "$(monotonic_seconds)"; json_add_int pid "$probe_pid"; json_add_string instance "$probe_instance"
  json_dump > "$PROTON_RUNTIME/client-health.json.$$"; mv "$PROTON_RUNTIME/client-health.json.$$" "$PROTON_RUNTIME/client-health.json"
  vpn_ready
  ;;
 stop) stop_tunnel;;
 *) exit 2;;
esac
