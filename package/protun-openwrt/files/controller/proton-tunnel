#!/bin/sh
set -e
umask 077
. /usr/lib/exit-node-common
case "${1:-}" in
 prepare)
  if [ "$VPN_BACKEND" != wireguard ]; then
   [ ! -x /usr/libexec/proton-wireguard ] || /usr/libexec/proton-wireguard stop
   exec /usr/libexec/proton-stealth "$@"
  fi
  /usr/libexec/proton-stealth stop
  exec /usr/libexec/proton-wireguard "$@";;
 test|health)
  if [ "$VPN_BACKEND" != wireguard ]; then exec /usr/libexec/proton-stealth "$@"; fi
  [ "$1" != health ] || exit 0
  exec /usr/libexec/proton-wireguard "$@";;
 live) [ "$#" -eq 1 ] && vpn_engine_live;;
 stop)
  /usr/libexec/proton-stealth stop
  [ ! -x /usr/libexec/proton-wireguard ] || exec /usr/libexec/proton-wireguard stop;;
 *) exit 2;;
esac
