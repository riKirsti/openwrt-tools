#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

start_service() {
	local enabled client_config private_key
	config_load protun
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get client_config main config /etc/protun/client.json
	/usr/sbin/protun-openwrt --check-config "$client_config" || return 1
	private_key="$(jsonfilter -i "$client_config" -e '@.private_key_file')" || private_key=
	procd_open_instance main
	procd_set_param command /usr/sbin/protun-openwrt --config "$client_config"
	procd_set_param file "$client_config"
	[ -z "$private_key" ] || procd_append_param file "$private_key"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

service_triggers() {
	local uplink_interface
	procd_add_reload_trigger protun
	config_load protun
	config_get uplink_interface main uplink_interface wan
	procd_add_interface_trigger 'interface.*' "$uplink_interface" /etc/init.d/protun restart
}
